# .env.example — Git에 올라가는 템플릿. 복사해서 .env 를 만든다: cp .env.example .env
# .env 는 커밋하지 않는다. 비밀 값(액세스 키 등)은 여기 넣지 말고 ~/.aws/credentials 에 둔다.

# ── AWS 접속 ──────────────────────────────────────────────
# 학교 계정은 MFA 없이 CLI 요청이 거부되므로 scripts/mfa_session.sh 로 만든 임시 프로필을 쓴다.
AWS_PROFILE=mfa
AWS_REGION=ap-northeast-2

# ── 자원 이름 (공용 계정이므로 학번을 붙여 구분) ──────────────
BUCKET_NAME=bike-demand-<학번>
FUNCTION_NAME=bike-demand-<학번>
ECR_REPO_NAME=bike-demand-<학번>
OWNER_TAG=<학번>

# 학생은 IAM 역할을 만들 수 없어(StudentGuardrails) 학교가 제공한 Lambda 기본 역할을 쓴다.
LAMBDA_ROLE_NAME=yeonsung-lambda-basic-role
