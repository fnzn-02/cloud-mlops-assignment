# .env.example — 이 파일은 Git에 올라가는 템플릿입니다.
# 실제 값은 .env 파일에 넣고, .env는 절대 커밋하지 마세요.

# ── AWS 설정 ──────────────────────────────────────────────
# AWS 자격증명은 여기에 넣지 말고 ~/.aws/credentials 에 넣으세요.
# (aws configure 또는 직접 붙여넣기)

# ── 프로젝트 설정 ──────────────────────────────────────────
BUCKET_NAME=your-bucket-name
FUNCTION_NAME=bike-demand
AWS_REGION=us-east-1
ECR_REPO_NAME=bike-demand
